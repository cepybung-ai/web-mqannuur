Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<FilesMatch "(?i)^(?:config\.(?:local|example)\.php|README\.md|composer\.(?:json|lock)|\.env.*|.*\.(?:sql|sh|log|ini|bak|swp))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
