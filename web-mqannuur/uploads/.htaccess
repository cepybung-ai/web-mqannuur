Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|htaccess)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
